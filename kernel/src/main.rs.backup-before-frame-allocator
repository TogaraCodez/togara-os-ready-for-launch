fn premium_background(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
) {
    // Deep navy/purple atmospheric field.
    for y in 0..height {
        let yy = y as u64;
        let hh = height.max(1) as u64;
        let vertical = (yy * 255 / hh) as u8;

        for x in 0..width {
            let xx = x as i64;
            let cx = width as i64 / 2;
            let cy = height as i64 / 2;
            let dx = xx - cx;
            let dy = y as i64 - cy;
            let d = ((dx * dx + dy * dy) as u64).min(8_000_000);
            let radial = 255u64.saturating_sub(d * 255 / 8_000_000);

            let purple = (radial * 18 / 255) as u8;
            let blue = (radial * 30 / 255) as u8;

            let r = 3u16 + purple as u16 + (vertical as u16 * 3 / 255);
            let g = 4u16 + (purple as u16 / 3);
            let b = 15u16 + blue as u16 + (vertical as u16 * 7 / 255);

            pixel(
                buf,
                width,
                height,
                stride,
                bpp,
                fmt,
                x,
                y,
                [r.min(255) as u8, g.min(255) as u8, b.min(255) as u8],
            );
        }
    }

    // Fine holographic grid.
    let gx = (width / 56).max(12);
    let gy = (height / 36).max(10);

    let mut x = 0;
    while x < width {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            x,
            0,
            x,
            height.saturating_sub(1),
            if x % (gx * 4) == 0 {
                [5, 17, 38]
            } else {
                [3, 9, 25]
            },
        );
        x += gx;
    }

    let mut y = 0;
    while y < height {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            0,
            y,
            width.saturating_sub(1),
            y,
            if y % (gy * 4) == 0 {
                [5, 17, 38]
            } else {
                [3, 9, 25]
            },
        );
        y += gy;
    }

    // Soft energy clouds.
    glow_circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width * 78 / 100,
        height * 43 / 100,
        width.min(height) / 3,
        [30, 18, 90],
        18,
    );
    glow_circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width * 58 / 100,
        height * 54 / 100,
        width.min(height) / 4,
        [10, 35, 78],
        13,
    );
}

fn holographic_panel(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    w: usize,
    h: usize,
    accent: [u8; 3],
) {
    if w < 10 || h < 10 {
        return;
    }

    let x2 = x.saturating_add(w).min(width);
    let y2 = y.saturating_add(h).min(height);

    // Translucent dark glass.
    for yy in y..y2 {
        for xx in x..x2 {
            let edge = xx == x || xx + 1 == x2 || yy == y || yy + 1 == y2;
            let base = if edge { [8, 13, 31] } else { [4, 8, 22] };
            blend_pixel(
                buf,
                width,
                height,
                stride,
                bpp,
                fmt,
                xx,
                yy,
                base,
                if edge { 185 } else { 225 },
            );
        }
    }

    // Luminous edge.
    glow_frame(buf, width, height, stride, bpp, fmt, x, y, w, h, accent);

    // Inner reflection line.
    if w > 30 {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            x + 10,
            y + 2,
            x2.saturating_sub(10),
            y + 2,
            [18, 42, 63],
        );
    }
}

fn gradient_text(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    value: &str,
    scale: usize,
    left: [u8; 3],
    right: [u8; 3],
) {
    let count = value.len().max(1);
    for (i, byte) in value.bytes().enumerate() {
        let t = (i * 255 / count.saturating_sub(1).max(1)) as u16;

        let color = [
            ((left[0] as u16 * (255 - t) + right[0] as u16 * t) / 255) as u8,
            ((left[1] as u16 * (255 - t) + right[1] as u16 * t) / 255) as u8,
            ((left[2] as u16 * (255 - t) + right[2] as u16 * t) / 255) as u8,
        ];

        let char_x = x + i * 6 * scale;
        text_scaled(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            char_x,
            y,
            &byte_to_string(byte),
            scale,
            color,
            true,
        );
    }
}

fn byte_to_string(byte: u8) -> &'static str {
    match byte {
        b'A' | b'a' => "A",
        b'B' | b'b' => "B",
        b'C' | b'c' => "C",
        b'D' | b'd' => "D",
        b'E' | b'e' => "E",
        b'F' | b'f' => "F",
        b'G' | b'g' => "G",
        b'H' | b'h' => "H",
        b'I' | b'i' => "I",
        b'J' | b'j' => "J",
        b'K' | b'k' => "K",
        b'L' | b'l' => "L",
        b'M' | b'm' => "M",
        b'N' | b'n' => "N",
        b'O' | b'o' => "O",
        b'P' | b'p' => "P",
        b'Q' | b'q' => "Q",
        b'R' | b'r' => "R",
        b'S' | b's' => "S",
        b'T' | b't' => "T",
        b'U' | b'u' => "U",
        b'V' | b'v' => "V",
        b'W' | b'w' => "W",
        b'X' | b'x' => "X",
        b'Y' | b'y' => "Y",
        b'Z' | b'z' => "Z",
        b'0'..=b'9' | b'.' | b' ' => match byte {
            b'0' => "0",
            b'1' => "1",
            b'2' => "2",
            b'3' => "3",
            b'4' => "4",
            b'5' => "5",
            b'6' => "6",
            b'7' => "7",
            b'8' => "8",
            b'9' => "9",
            b'.' => ".",
            _ => " ",
        },
        _ => " ",
    }
}

