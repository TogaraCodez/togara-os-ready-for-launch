#![no_std]
#![no_main]
#![feature(abi_x86_interrupt)]

mod interrupts;
mod memory;
mod system;

use bootloader_api::info::{FrameBuffer, PixelFormat};
use bootloader_api::{BootInfo, entry_point};
use core::panic::PanicInfo;

const CYAN: [u8; 3] = [40, 245, 255];
const MAGENTA: [u8; 3] = [255, 35, 220];
const GOLD: [u8; 3] = [255, 205, 70];
const WHITE: [u8; 3] = [235, 252, 255];
const DIM: [u8; 3] = [82, 125, 155];
const GREEN: [u8; 3] = [70, 255, 165];
const RED: [u8; 3] = [255, 75, 95];

const MAX_INPUT: usize = 64;

entry_point!(kernel_main);

#[panic_handler]
fn panic(_info: &PanicInfo) -> ! {
    loop {
        core::hint::spin_loop();
    }
}

fn kernel_main(boot_info: &'static mut BootInfo) -> ! {
    let usable_memory_regions = memory::init(boot_info.memory_regions.as_ref());

    interrupts::init();

    if let Some(framebuffer) = boot_info.framebuffer.as_mut() {
        run_desktop(framebuffer, usable_memory_regions);
    }

    loop {
        core::hint::spin_loop();
    }
}

fn run_desktop(framebuffer: &mut FrameBuffer, usable_memory_regions: usize) -> ! {
    let mut input = [0u8; MAX_INPUT];
    let mut input_len = 0usize;

    draw_desktop(
        framebuffer,
        usable_memory_regions,
        &input,
        input_len,
        "",
        GREEN,
    );

    loop {
        let scancode = match interrupts::keyboard::pop_scancode() {
            Some(scancode) => scancode,
            None => {
                core::hint::spin_loop();
                continue;
            }
        };

        // Ignore key-release scancodes.
        if scancode & 0x80 != 0 {
            continue;
        }

        let ascii = scancode_to_ascii(scancode);

        if ascii == b'\n' {
            let result = execute_command(&input[..input_len]);
            let message = core::str::from_utf8(&result.message[..result.len]).unwrap_or("");

            draw_desktop(
                framebuffer,
                usable_memory_regions,
                &input,
                input_len,
                message,
                result.color,
            );

            input_len = 0;
            input.fill(0);
        } else if ascii == 8 {
            if input_len > 0 {
                input_len -= 1;
                input[input_len] = 0;
            }

            draw_desktop(
                framebuffer,
                usable_memory_regions,
                &input,
                input_len,
                "",
                GREEN,
            );
        } else if ascii != 0 && input_len < MAX_INPUT {
            input[input_len] = ascii;
            input_len += 1;

            draw_desktop(
                framebuffer,
                usable_memory_regions,
                &input,
                input_len,
                "",
                GREEN,
            );
        }
    }
}

fn scancode_to_ascii(scancode: u8) -> u8 {
    match scancode {
        // Number row.
        0x02 => b'1',
        0x03 => b'2',
        0x04 => b'3',
        0x05 => b'4',
        0x06 => b'5',
        0x07 => b'6',
        0x08 => b'7',
        0x09 => b'8',
        0x0A => b'9',
        0x0B => b'0',

        // QWERTY.
        0x10 => b'Q',
        0x11 => b'W',
        0x12 => b'E',
        0x13 => b'R',
        0x14 => b'T',
        0x15 => b'Y',
        0x16 => b'U',
        0x17 => b'I',
        0x18 => b'O',
        0x19 => b'P',

        0x1E => b'A',
        0x1F => b'S',
        0x20 => b'D',
        0x21 => b'F',
        0x22 => b'G',
        0x23 => b'H',
        0x24 => b'J',
        0x25 => b'K',
        0x26 => b'L',

        0x2C => b'Z',
        0x2D => b'X',
        0x2E => b'C',
        0x2F => b'V',
        0x30 => b'B',
        0x31 => b'N',
        0x32 => b'M',

        // Controls / symbols.
        0x39 => b' ',
        0x0C => b'-',
        0x0D => b'=',
        0x1C => b'\n',
        0x0E => 8,

        _ => 0,
    }
}

const MAX_COMMAND_OUTPUT: usize = 128;

struct CommandResult {
    message: [u8; MAX_COMMAND_OUTPUT],
    len: usize,
    color: [u8; 3],
}

impl CommandResult {
    const fn empty(color: [u8; 3]) -> Self {
        Self {
            message: [0; MAX_COMMAND_OUTPUT],
            len: 0,
            color,
        }
    }

    fn push_bytes(&mut self, bytes: &[u8]) {
        let mut i = 0;

        while i < bytes.len() && self.len < MAX_COMMAND_OUTPUT {
            self.message[self.len] = bytes[i];
            self.len += 1;
            i += 1;
        }
    }

    fn push_u64(&mut self, mut value: u64) {
        let mut digits = [0u8; 20];
        let mut len = 0usize;

        if value == 0 {
            self.push_bytes(b"0");
            return;
        }

        while value > 0 && len < digits.len() {
            digits[len] = b'0' + (value % 10) as u8;
            value /= 10;
            len += 1;
        }

        while len > 0 {
            len -= 1;
            self.push_bytes(&[digits[len]]);
        }
    }

    fn push_u64_padded(&mut self, mut value: u64, width: usize) {
        let mut divisor = 1u64;
        let mut i = 1usize;

        while i < width {
            divisor *= 10;
            i += 1;
        }

        while divisor > 0 {
            let digit = value / divisor;
            self.push_bytes(&[b'0' + digit as u8]);
            value %= divisor;
            divisor /= 10;
        }
    }
}

fn command_result(message: &[u8], color: [u8; 3]) -> CommandResult {
    let mut result = CommandResult::empty(color);
    result.push_bytes(message);
    result
}

fn execute_command(command: &[u8]) -> CommandResult {
    if equals(command, b"HELP") {
        return command_result(
            b"COMMANDS: HELP REALMS MEMORY EVENTS SYSTEM UPTIME CLEAR ABOUT",
            CYAN,
        );
    }

    if equals(command, b"REALMS") {
        return command_result(b"REALMS: CORE MEMORY EVENTS NETWORK SHELL", MAGENTA);
    }

    if equals(command, b"MEMORY") {
        let mut result = CommandResult::empty(GOLD);

        result.push_bytes(b"MEMORY ONLINE | ");
        result.push_bytes(b"USABLE ");
        result.push_u64(memory::usable_mib());
        result.push_bytes(b" MiB | TOTAL ");
        result.push_u64(memory::total_mib());
        result.push_bytes(b" MiB | REGIONS ");
        result.push_u64(memory::region_count());
        result.push_bytes(b" | ALLOCATOR OFFLINE");

        return result;
    }

    if equals(command, b"EVENTS") {
        let events = system::state::keyboard_events();

        let mut result = CommandResult::empty(CYAN);
        result.push_bytes(b"EVENT FABRIC ONLINE - KEYBOARD EVENTS: ");
        result.push_u64(events);

        return result;
    }

    if equals(command, b"UPTIME") {
        let seconds = system::state::uptime_seconds();
        let millis = system::state::uptime_millis();

        let mut result = CommandResult::empty(GREEN);
        result.push_bytes(b"UPTIME: ");
        result.push_u64(seconds);
        result.push_bytes(b".");
        result.push_u64_padded(millis, 3);
        result.push_bytes(b" SEC");

        return result;
    }

    if equals(command, b"SYSTEM") {
        let ticks = system::state::uptime_ticks();

        let mut result = CommandResult::empty(GREEN);
        result.push_bytes(b"TOGARA CORE ONLINE - STATE FABRIC ACTIVE - TICKS: ");
        result.push_u64(ticks);

        return result;
    }

    if equals(command, b"CLEAR") {
        return CommandResult::empty(WHITE);
    }

    if equals(command, b"ABOUT") {
        return command_result(b"TOGARA OS - BARE METAL OPERATING INTELLIGENCE", WHITE);
    }

    if command.is_empty() {
        return CommandResult::empty(WHITE);
    }

    command_result(b"UNKNOWN COMMAND - TYPE HELP", RED)
}

fn equals(value: &[u8], expected: &[u8]) -> bool {
    if value.len() != expected.len() {
        return false;
    }

    let mut i = 0;

    while i < expected.len() {
        if value[i] != expected[i] {
            return false;
        }

        i += 1;
    }

    true
}

fn draw_desktop(
