fn holographic_background(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
) {
    let cx = width / 2;
    let cy = height / 2;
    let max_d = ((width * width + height * height) as u64).max(1);
    for y in 0..height {
        for x in 0..width {
            let dx = x as i64 - cx as i64;
            let dy = y as i64 - cy as i64;
            let d2 = (dx * dx + dy * dy) as u64;
            let radial = 255u64.saturating_sub(d2.saturating_mul(255) / max_d);
            let band = ((y * 255) / height.max(1)) as u64;
            let r = 2 + radial * 15 / 255 + band * 2 / 255;
            let g = 2 + radial * 7 / 255;
            let b = 11 + radial * 35 / 255 + band * 7 / 255;
            pixel(
                buf,
                width,
                height,
                stride,
                bpp,
                fmt,
                x,
                y,
                [r.min(255) as u8, g.min(255) as u8, b.min(255) as u8],
            );
        }
    }
    let grid = (width / 120).max(12);
    let mut y = 0;
    while y < height {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            0,
            y,
            width - 1,
            y,
            if y % (grid * 8) == 0 {
                [4, 11, 31]
            } else {
                [2, 6, 18]
            },
        );
        y += grid;
    }
    let mut x = 0;
    while x < width {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            x,
            0,
            x,
            height - 1,
            if x % (grid * 8) == 0 {
                [4, 11, 31]
            } else {
                [2, 6, 18]
            },
        );
        x += grid;
    }
    glow_circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width * 73 / 100,
        height * 44 / 100,
        width.min(height) / 3,
        [12, 30, 72],
        30,
    );
    glow_circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width * 73 / 100,
        height * 44 / 100,
        width.min(height) / 5,
        [14, 60, 80],
        24,
    );
}

fn holographic_chassis(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    inset: usize,
) {
    let x = inset;
    let y = inset;
    let w = width.saturating_sub(inset * 2);
    let h = height.saturating_sub(inset * 2);
    frame(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x,
        y,
        w,
        h,
        [8, 45, 70],
    );
    let arm = (width.min(height) / 24).max(22);
    line(buf, width, height, stride, bpp, fmt, x, y, x + arm, y, CYAN);
    line(buf, width, height, stride, bpp, fmt, x, y, x, y + arm, CYAN);
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width - x - arm,
        y,
        width - x,
        y,
        MAGENTA,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width - x,
        y,
        width - x,
        y + arm,
        MAGENTA,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x,
        height - y,
        x + arm,
        height - y,
        GOLD,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x,
        height - y - arm,
        x,
        height - y,
        GOLD,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width - x - arm,
        height - y,
        width - x,
        height - y,
        CYAN,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        width - x,
        height - y - arm,
        width - x,
        height - y,
        CYAN,
    );
}

fn glass_surface(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    w: usize,
    h: usize,
    accent: [u8; 3],
) {
    if w < 8 || h < 8 || x >= width || y >= height {
        return;
    }
    let x2 = x.saturating_add(w).min(width);
    let y2 = y.saturating_add(h).min(height);
    for yy in y..y2 {
        let v = if h > 1 { ((yy - y) * 7 / h) as u8 } else { 0 };
        for xx in x..x2 {
            let edge = if xx == x || xx + 1 == x2 || yy == y || yy + 1 == y2 {
                9
            } else {
                3
            };
            pixel(
                buf,
                width,
                height,
                stride,
                bpp,
                fmt,
                xx,
                yy,
                [2 + edge / 2, 5 + edge / 2 + v / 2, 18 + edge + v],
            );
        }
    }
    glow_frame(buf, width, height, stride, bpp, fmt, x, y, w, h, accent);
}

fn holographic_orb(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    cx: usize,
    cy: usize,
    r: usize,
) {
    glow_circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        r + 42,
        [10, 55, 85],
        42,
    );
    glow_circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        r + 18,
        [20, 75, 105],
        35,
    );
    // Elliptical-looking orbit bands made from offset circular rings.
    orbit_ring(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy - 7,
        r + 30,
        [10, 70, 95],
    );
    orbit_ring(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy + 6,
        r + 22,
        [85, 15, 92],
    );
    ring(buf, width, height, stride, bpp, fmt, cx, cy, r, CYAN);
    ring(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        r.saturating_sub(11),
        MAGENTA,
    );
    glow_circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        r / 2,
        [12, 70, 90],
        55,
    );
    circle(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        r / 2,
        [4, 18, 38],
    );
    ring(buf, width, height, stride, bpp, fmt, cx, cy, r / 2, CYAN);
    diamond(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        (r / 6).max(8),
        CYAN,
    );
}

