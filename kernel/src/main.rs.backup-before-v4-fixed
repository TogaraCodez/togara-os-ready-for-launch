#![no_std]
#![no_main]
#![feature(abi_x86_interrupt)]

mod interrupts;

use bootloader_api::info::{FrameBuffer, PixelFormat};
use bootloader_api::{BootInfo, entry_point};
use core::panic::PanicInfo;

const CYAN: [u8; 3] = [40, 245, 255];
const MAGENTA: [u8; 3] = [255, 35, 220];
const GOLD: [u8; 3] = [255, 205, 70];
const WHITE: [u8; 3] = [235, 252, 255];
const DIM: [u8; 3] = [82, 125, 155];
const DIM2: [u8; 3] = [38, 67, 92];
const GREEN: [u8; 3] = [70, 255, 165];
const RED: [u8; 3] = [255, 75, 95];

const MAX_INPUT: usize = 64;

entry_point!(kernel_main);

#[panic_handler]
fn panic(_info: &PanicInfo) -> ! {
    loop {
        core::hint::spin_loop();
    }
}

fn kernel_main(boot_info: &'static mut BootInfo) -> ! {
    let usable_memory_regions = boot_info
        .memory_regions
        .iter()
        .filter(|region| matches!(region.kind, bootloader_api::info::MemoryRegionKind::Usable))
        .count();

    interrupts::init();

    if let Some(framebuffer) = boot_info.framebuffer.as_mut() {
        run_desktop(framebuffer, usable_memory_regions);
    }

    loop {
        core::hint::spin_loop();
    }
}

fn run_desktop(framebuffer: &mut FrameBuffer, usable_memory_regions: usize) -> ! {
    let mut input = [0u8; MAX_INPUT];
    let mut input_len = 0usize;

    draw_desktop(
        framebuffer,
        usable_memory_regions,
        &input,
        input_len,
        "",
        GREEN,
    );

    loop {
        let scancode = match interrupts::keyboard::pop_scancode() {
            Some(scancode) => scancode,
            None => {
                core::hint::spin_loop();
                continue;
            }
        };

        // Ignore key-release scancodes.
        if scancode & 0x80 != 0 {
            continue;
        }

        let ascii = scancode_to_ascii(scancode);

        if ascii == b'\n' {
            let result = execute_command(&input[..input_len]);

            draw_desktop(
                framebuffer,
                usable_memory_regions,
                &input,
                input_len,
                result.0,
                result.1,
            );

            input_len = 0;
            input.fill(0);
        } else if ascii == 8 {
            if input_len > 0 {
                input_len -= 1;
                input[input_len] = 0;
            }

            draw_desktop(
                framebuffer,
                usable_memory_regions,
                &input,
                input_len,
                "",
                GREEN,
            );
        } else if ascii != 0 && input_len < MAX_INPUT {
            input[input_len] = ascii;
            input_len += 1;

            draw_desktop(
                framebuffer,
                usable_memory_regions,
                &input,
                input_len,
                "",
                GREEN,
            );
        }
    }
}

fn scancode_to_ascii(scancode: u8) -> u8 {
    match scancode {
        // Number row.
        0x02 => b'1',
        0x03 => b'2',
        0x04 => b'3',
        0x05 => b'4',
        0x06 => b'5',
        0x07 => b'6',
        0x08 => b'7',
        0x09 => b'8',
        0x0A => b'9',
        0x0B => b'0',

        // QWERTY.
        0x10 => b'Q',
        0x11 => b'W',
        0x12 => b'E',
        0x13 => b'R',
        0x14 => b'T',
        0x15 => b'Y',
        0x16 => b'U',
        0x17 => b'I',
        0x18 => b'O',
        0x19 => b'P',

        0x1E => b'A',
        0x1F => b'S',
        0x20 => b'D',
        0x21 => b'F',
        0x22 => b'G',
        0x23 => b'H',
        0x24 => b'J',
        0x25 => b'K',
        0x26 => b'L',

        0x2C => b'Z',
        0x2D => b'X',
        0x2E => b'C',
        0x2F => b'V',
        0x30 => b'B',
        0x31 => b'N',
        0x32 => b'M',

        // Controls / symbols.
        0x39 => b' ',
        0x0C => b'-',
        0x0D => b'=',
        0x1C => b'\n',
        0x0E => 8,

        _ => 0,
    }
}

fn execute_command(command: &[u8]) -> (&'static str, [u8; 3]) {
    if equals(command, b"HELP") {
        return (
            "COMMANDS: HELP REALMS MEMORY EVENTS SYSTEM CLEAR ABOUT",
            CYAN,
        );
    }

    if equals(command, b"REALMS") {
        return ("REALMS: CORE MEMORY EVENTS NETWORK SHELL", MAGENTA);
    }

    if equals(command, b"MEMORY") {
        return ("MEMORY REALM ONLINE - BOOT MEMORY MAP AVAILABLE", GOLD);
    }

    if equals(command, b"EVENTS") {
        return ("EVENT FABRIC ONLINE - INPUT EVENTS ACTIVE", CYAN);
    }

    if equals(command, b"SYSTEM") {
        return ("TOGARA CORE ONLINE - KERNEL EXECUTING", GREEN);
    }

    if equals(command, b"CLEAR") {
        return ("", WHITE);
    }

    if equals(command, b"ABOUT") {
        return ("TOGARA OS - BARE METAL OPERATING INTELLIGENCE", WHITE);
    }

    if command.is_empty() {
        return ("", WHITE);
    }

    ("UNKNOWN COMMAND - TYPE HELP", RED)
}

fn equals(value: &[u8], expected: &[u8]) -> bool {
    if value.len() != expected.len() {
        return false;
    }

    let mut i = 0;

    while i < expected.len() {
        if value[i] != expected[i] {
            return false;
        }

        i += 1;
    }

    true
}

fn draw_desktop(
