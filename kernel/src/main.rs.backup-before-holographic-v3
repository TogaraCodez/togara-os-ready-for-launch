fn gradient_fill(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
) {
    if height == 0 {
        return;
    }

    for y in 0..height {
        let t = ((y * 255) / height) as u8;
        let color = [
            1u8.saturating_add(t / 45),
            2u8.saturating_add(t / 18),
            10u8.saturating_add(t / 9),
        ];

        for x in 0..width {
            pixel(buf, width, height, stride, bpp, fmt, x, y, color);
        }
    }
}

fn technical_background(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
) {
    // Sparse horizontal scan lines.
    let mut y = 8usize;
    while y < height {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            0,
            y,
            width.saturating_sub(1),
            y,
            [2, 7, 18],
        );
        y += 8;
    }

    // Only major vertical axes; avoids the "cheap grid" appearance.
    let mut x = 64usize;
    while x < width {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            x,
            0,
            x,
            height.saturating_sub(1),
            [2, 6, 16],
        );
        x += 128;
    }

    // Technical registration marks.
    for &(x, y) in &[
        (34usize, 130usize),
        (width.saturating_sub(35), 130usize),
        (34, height.saturating_sub(205)),
        (width.saturating_sub(35), height.saturating_sub(205)),
    ] {
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            x.saturating_sub(8),
            y,
            x + 8,
            y,
            DIM2,
        );
        line(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            x,
            y.saturating_sub(8),
            x,
            y + 8,
            DIM2,
        );
    }
}

fn glow_frame(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    w: usize,
    h: usize,
    color: [u8; 3],
) {
    if w < 4 || h < 4 {
        return;
    }

    let x2 = x.saturating_add(w).min(width);
    let y2 = y.saturating_add(h).min(height);

    // Dim halo first.
    frame(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x.saturating_sub(2),
        y.saturating_sub(2),
        w.saturating_add(4),
        h.saturating_add(4),
        [3, 18, 30],
    );

    // Crisp edge.
    frame(buf, width, height, stride, bpp, fmt, x, y, w, h, color);

    // Bright micro-highlights only at the top and left.
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x + 2,
        y + 1,
        x2.saturating_sub(3),
        y + 1,
        color,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x + 1,
        y + 2,
        x + 1,
        y2.saturating_sub(3),
        color,
    );
}

fn frame(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    w: usize,
    h: usize,
    color: [u8; 3],
) {
    if w == 0 || h == 0 {
        return;
    }
    let x2 = x.saturating_add(w).min(width);
    let y2 = y.saturating_add(h).min(height);
    if x >= x2 || y >= y2 {
        return;
    }
    for xx in x..x2 {
        pixel(buf, width, height, stride, bpp, fmt, xx, y, color);
        pixel(buf, width, height, stride, bpp, fmt, xx, y2 - 1, color);
    }
    for yy in y..y2 {
        pixel(buf, width, height, stride, bpp, fmt, x, yy, color);
        pixel(buf, width, height, stride, bpp, fmt, x2 - 1, yy, color);
    }
}

fn corner_brackets(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    w: usize,
    h: usize,
) {
    if w < 20 || h < 20 {
        return;
    }
    let x2 = x.saturating_add(w).min(width.saturating_sub(1));
    let y2 = y.saturating_add(h).min(height.saturating_sub(1));
    let arm = 28usize;
    let c1 = CYAN;
    let c2 = MAGENTA;
    let c3 = GOLD;

    line(buf, width, height, stride, bpp, fmt, x, y, x + arm, y, c1);
    line(buf, width, height, stride, bpp, fmt, x, y, x, y + arm, c1);
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x2.saturating_sub(arm),
        y,
        x2,
        y,
        c2,
    );
    line(buf, width, height, stride, bpp, fmt, x2, y, x2, y + arm, c2);
    line(buf, width, height, stride, bpp, fmt, x, y2, x + arm, y2, c3);
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x,
        y2.saturating_sub(arm),
        x,
        y2,
        c3,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x2.saturating_sub(arm),
        y2,
        x2,
        y2,
        c1,
    );
    line(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        x2,
        y2.saturating_sub(arm),
        x2,
        y2,
        c1,
    );
}

fn diamond(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    cx: usize,
    cy: usize,
    radius: usize,
    color: [u8; 3],
) {
    let r = radius as isize;
    for dy in -r..=r {
        let span = r - dy.abs();
        let y = cy as isize + dy;
        if y < 0 {
            continue;
        }
        for dx in -span..=span {
            let x = cx as isize + dx;
            if x >= 0 {
                pixel(
                    buf, width, height, stride, bpp, fmt, x as usize, y as usize, color,
                );
            }
        }
    }
}

fn node(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    cx: usize,
    cy: usize,
    color: [u8; 3],
) {
    ring(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        29,
        [8, 45, 66],
    );
    ring(buf, width, height, stride, bpp, fmt, cx, cy, 23, color);
    ring(
        buf,
        width,
        height,
        stride,
        bpp,
        fmt,
        cx,
        cy,
        15,
        [10, 35, 55],
    );
    diamond(buf, width, height, stride, bpp, fmt, cx, cy, 8, color);
    diamond(buf, width, height, stride, bpp, fmt, cx, cy, 3, WHITE);
}

fn pixel(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    color: [u8; 3],
) {
    if x >= width || y >= height || bpp < 3 {
        return;
    }

    let p = (y * stride + x) * bpp;

    if p + 2 >= buf.len() {
        return;
    }

    match fmt {
        PixelFormat::Bgr => {
            buf[p] = color[2];
            buf[p + 1] = color[1];
            buf[p + 2] = color[0];
        }

        _ => {
            buf[p] = color[0];
            buf[p + 1] = color[1];
            buf[p + 2] = color[2];
        }
    }
}

fn fill(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    color: [u8; 3],
) {
    for y in 0..height {
        for x in 0..width {
            pixel(buf, width, height, stride, bpp, fmt, x, y, color);
        }
    }
}

fn panel(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    w: usize,
    h: usize,
    fill_color: [u8; 3],
    border_color: [u8; 3],
) {
    let x2 = x.saturating_add(w).min(width);
    let y2 = y.saturating_add(h).min(height);

    for yy in y..y2 {
        for xx in x..x2 {
            pixel(buf, width, height, stride, bpp, fmt, xx, yy, fill_color);
        }
    }

    for xx in x..x2 {
        pixel(buf, width, height, stride, bpp, fmt, xx, y, border_color);

        if y2 > 0 {
            pixel(
                buf,
                width,
                height,
                stride,
                bpp,
                fmt,
                xx,
                y2 - 1,
                border_color,
            );
        }
    }

    for yy in y..y2 {
        pixel(buf, width, height, stride, bpp, fmt, x, yy, border_color);

        if x2 > 0 {
            pixel(
                buf,
                width,
                height,
                stride,
                bpp,
                fmt,
                x2 - 1,
                yy,
                border_color,
            );
        }
    }
}

fn circle(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    cx: usize,
    cy: usize,
    r: usize,
    color: [u8; 3],
) {
    let r2 = (r * r) as isize;

    let minx = cx.saturating_sub(r);
    let maxx = (cx + r).min(width.saturating_sub(1));

    let miny = cy.saturating_sub(r);
    let maxy = (cy + r).min(height.saturating_sub(1));

    for y in miny..=maxy {
        for x in minx..=maxx {
            let dx = x as isize - cx as isize;
            let dy = y as isize - cy as isize;

            if dx * dx + dy * dy <= r2 {
                pixel(buf, width, height, stride, bpp, fmt, x, y, color);
            }
        }
    }
}

fn ring(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    cx: usize,
    cy: usize,
    r: usize,
    color: [u8; 3],
) {
    let outer = (r * r) as isize;
    let inner_r = r.saturating_sub(2);
    let inner = (inner_r * inner_r) as isize;

    let minx = cx.saturating_sub(r);
    let maxx = (cx + r).min(width.saturating_sub(1));

    let miny = cy.saturating_sub(r);
    let maxy = (cy + r).min(height.saturating_sub(1));

    for y in miny..=maxy {
        for x in minx..=maxx {
            let dx = x as isize - cx as isize;
            let dy = y as isize - cy as isize;
            let distance = dx * dx + dy * dy;

            if distance <= outer && distance >= inner {
                pixel(buf, width, height, stride, bpp, fmt, x, y, color);
            }
        }
    }
}

fn line(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    start_x: usize,
    start_y: usize,
    end_x: usize,
    end_y: usize,
    color: [u8; 3],
) {
    let mut x0 = start_x as isize;
    let mut y0 = start_y as isize;

    let x1 = end_x as isize;
    let y1 = end_y as isize;

    let dx = (x1 - x0).abs();
    let sx = if x0 < x1 { 1 } else { -1 };

    let dy = -(y1 - y0).abs();
    let sy = if y0 < y1 { 1 } else { -1 };

    let mut error = dx + dy;

    loop {
        if x0 >= 0 && y0 >= 0 {
            pixel(
                buf,
                width,
                height,
                stride,
                bpp,
                fmt,
                x0 as usize,
                y0 as usize,
                color,
            );
        }

        if x0 == x1 && y0 == y1 {
            break;
        }

        let e2 = 2 * error;

        if e2 >= dy {
            error += dy;
            x0 += sx;
        }

        if e2 <= dx {
            error += dx;
            y0 += sy;
        }
    }
}

fn text_bytes(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    bytes: &[u8],
    len: usize,
    scale: usize,
    color: [u8; 3],
) {
    let mut offset = x;

    for i in 0..len.min(bytes.len()) {
        let glyph_data = glyph(bytes[i]);

        draw_glyph(
            buf, width, height, stride, bpp, fmt, offset, y, glyph_data, scale, color,
        );

        offset += 6 * scale;
    }
}

fn text(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    value: &str,
    scale: usize,
    color: [u8; 3],
) {
    let mut offset = x;

    for byte in value.bytes() {
        draw_glyph(
            buf,
            width,
            height,
            stride,
            bpp,
            fmt,
            offset,
            y,
            glyph(byte),
            scale,
            color,
        );

        offset += 6 * scale;
    }
}

fn draw_glyph(
    buf: &mut [u8],
    width: usize,
    height: usize,
    stride: usize,
    bpp: usize,
    fmt: PixelFormat,
    x: usize,
    y: usize,
    glyph_data: [u8; 7],
    scale: usize,
    color: [u8; 3],
) {
    for gy in 0..7 {
        for gx in 0..5 {
            if glyph_data[gy] & (1 << (4 - gx)) != 0 {
                for sy in 0..scale {
                    for sx in 0..scale {
                        pixel(
                            buf,
                            width,
                            height,
                            stride,
                            bpp,
                            fmt,
                            x + gx * scale + sx,
                            y + gy * scale + sy,
                            color,
                        );
                    }
                }
            }
        }
    }
}

fn glyph(ch: u8) -> [u8; 7] {
    match ch {
        b'A' => [0x0E, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11],
        b'B' => [0x1E, 0x11, 0x11, 0x1E, 0x11, 0x11, 0x1E],
        b'C' => [0x0F, 0x10, 0x10, 0x10, 0x10, 0x10, 0x0F],
        b'D' => [0x1E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1E],
        b'E' => [0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x1F],
        b'F' => [0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x10],
        b'G' => [0x0F, 0x10, 0x10, 0x17, 0x11, 0x11, 0x0F],
        b'H' => [0x11, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11],
        b'I' => [0x1F, 0x04, 0x04, 0x04, 0x04, 0x04, 0x1F],
        b'J' => [0x01, 0x01, 0x01, 0x01, 0x11, 0x11, 0x0E],
        b'K' => [0x11, 0x12, 0x14, 0x18, 0x14, 0x12, 0x11],
        b'L' => [0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x1F],
        b'M' => [0x11, 0x1B, 0x15, 0x15, 0x11, 0x11, 0x11],
        b'N' => [0x11, 0x19, 0x15, 0x13, 0x11, 0x11, 0x11],
        b'O' => [0x0E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E],
        b'P' => [0x1E, 0x11, 0x11, 0x1E, 0x10, 0x10, 0x10],
        b'Q' => [0x0E, 0x11, 0x11, 0x11, 0x15, 0x12, 0x0D],
        b'R' => [0x1E, 0x11, 0x11, 0x1E, 0x14, 0x12, 0x11],
        b'S' => [0x0F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E],
        b'T' => [0x1F, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04],
        b'U' => [0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E],
        b'V' => [0x11, 0x11, 0x11, 0x11, 0x11, 0x0A, 0x04],
        b'W' => [0x11, 0x11, 0x11, 0x15, 0x15, 0x1B, 0x11],
        b'X' => [0x11, 0x11, 0x0A, 0x04, 0x0A, 0x11, 0x11],
        b'Y' => [0x11, 0x11, 0x0A, 0x04, 0x04, 0x04, 0x04],
        b'Z' => [0x1F, 0x01, 0x02, 0x04, 0x08, 0x10, 0x1F],

        b'0' => [0x0E, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0E],
        b'1' => [0x04, 0x0C, 0x04, 0x04, 0x04, 0x04, 0x0E],
        b'2' => [0x0E, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1F],
        b'3' => [0x1E, 0x01, 0x01, 0x0E, 0x01, 0x01, 0x1E],
        b'4' => [0x02, 0x06, 0x0A, 0x12, 0x1F, 0x02, 0x02],
        b'5' => [0x1F, 0x10, 0x10, 0x1E, 0x01, 0x01, 0x1E],
        b'6' => [0x06, 0x08, 0x10, 0x1E, 0x11, 0x11, 0x0E],
        b'7' => [0x1F, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08],
        b'8' => [0x0E, 0x11, 0x11, 0x0E, 0x11, 0x11, 0x0E],
        b'9' => [0x0E, 0x11, 0x11, 0x0F, 0x01, 0x02, 0x0C],

        b' ' => [0, 0, 0, 0, 0, 0, 0],
        b'>' => [0x10, 0x08, 0x04, 0x02, 0x04, 0x08, 0x10],
        b'-' => [0, 0, 0x1F, 0, 0, 0, 0],
        b'=' => [0, 0x1F, 0, 0x1F, 0, 0, 0],

        _ => [0x1F, 0x01, 0x05, 0x04, 0x04, 0, 0x04],
    }
}
