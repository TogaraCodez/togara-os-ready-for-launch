const CYAN_GLOW: [u8; 3] = [10, 92, 120];
const CYAN_DARK: [u8; 3] = [4, 30, 48];
const MAGENTA: [u8; 3] = [255, 35, 220];
const MAGENTA_GLOW: [u8; 3] = [92, 12, 78];
